<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="True">
    <ui:ListView show-add-remove-footer="true" reorderable="true" name="CloneAssets" show-border="true" horizontal-scrolling="false" show-bound-collection-size="false" reorder-mode="Animated" header-title="クローンするファイル・フォルダ" show-foldout-header="true" show-alternating-row-backgrounds="All" selection-type="Multiple" />
    <ui:Label text="保存先&#10;(&quot;./&quot;開始で相対パス、未入力で同じディレクトリに保存)" />
    <ui:VisualElement style="flex-direction: row;">
        <ui:TextField name="DistDir" style="flex-grow: 1;" />
        <ui:Button text="..." name="ReferenceButton" />
    </ui:VisualElement>
    <ui:Label />
    <ui:Toggle name="Clone2Variant" text="プレハブとマテリアルをバリアントとしてクローン" style="flex-direction: row;" />
    <ui:Button text="Clone" name="CloneButton" />
</ui:UXML>
